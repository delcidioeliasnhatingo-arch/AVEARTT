{% comment %}
  Renders product rating stars and review count
  Accepts:
  - rating: {Number} Decimal rating (e.g. 4.9)
  - count: {Number} Total reviews count
  - class: {String} Extra classes
{% endcomment %}

{%- assign rating_val = rating | default: 4.8 -%}
{%- assign count_val = count | default: 124 -%}

<div class="flex items-center gap-1.5 text-xs text-neutral-600 {{ class }}">
  <div class="flex items-center text-neutral-900" aria-label="{{ 'accessibility.star_rating' | t: rating: rating_val }}">
    {%- for i in (1..5) -%}
      {% render 'icon', name: 'star', class: 'w-3 h-3' %}
    {%- endfor -%}
  </div>
  <span class="font-medium text-neutral-900 tabular-nums">{{ rating_val }}</span>
  <span class="text-neutral-400">({{ count_val }})</span>
</div>
