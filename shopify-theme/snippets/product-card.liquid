{% comment %}
  Renders a minimalist gaming product card.
  Accepts:
  - product: {Object} Shopify Product object
  - show_vendor: {Boolean}
  - show_rating: {Boolean}
  - show_quick_add: {Boolean}
  - class: {String} Extra classes
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

<article class="product-card group {{ class }}">
  <div class="product-card-media relative">
    <a href="{{ product.url }}" class="block w-full h-full" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media != blank -%}
        <img
          src="{{ product.featured_media | image_url: width: 600 }}"
          alt="{{ product.title | escape }}"
          class="product-card-img"
          loading="lazy"
          width="600"
          height="600"
        >
        {%- if product.media[1] != blank and settings.show_secondary_image_on_hover -%}
          <img
            src="{{ product.media[1] | image_url: width: 600 }}"
            alt="{{ product.title | escape }} alternate view"
            class="product-card-img-secondary"
            loading="lazy"
            width="600"
            height="600"
          >
        {%- endif -%}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400">
          <span class="text-xs uppercase tracking-wider">No Image</span>
        </div>
      {%- endif -%}
    </a>

    {%- if on_sale -%}
      <div class="absolute top-2.5 left-2.5 z-10">
        <span class="text-[10px] font-bold tracking-wider uppercase bg-black text-white px-2 py-0.5 rounded-none">
          Sale
        </span>
      </div>
    {%- endif -%}

    {%- if show_quick_add and current_variant.available -%}
      <div class="product-card-quick-add">
        <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart>
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="w-full py-2 bg-neutral-900 text-white text-xs font-semibold tracking-wider uppercase hover:bg-neutral-800 transition-colors shadow-sm">
            {{ 'products.product.quick_add' | t }}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>

  <div class="p-4 flex flex-col flex-1 bg-white justify-between">
    <div>
      {%- if show_vendor and product.vendor != blank -%}
        <p class="text-[11px] font-semibold tracking-wider text-neutral-400 uppercase mb-1">
          {{ product.vendor }}
        </p>
      {%- endif -%}

      <h3 class="text-sm font-semibold text-neutral-900 line-clamp-2 hover:text-neutral-600 transition-colors">
        <a href="{{ product.url }}">
          {{ product.title }}
        </a>
      </h3>

      {%- if show_rating -%}
        <div class="mt-1.5">
          {% render 'rating', rating: 4.9, count: 86 %}
        </div>
      {%- endif -%}
    </div>

    <div class="mt-3 pt-3 border-t border-neutral-100 flex items-center justify-between">
      {% render 'price', product: product, use_variant: true %}

      {%- if current_variant.available -%}
        <span class="text-[11px] font-medium text-neutral-500">In Stock</span>
      {%- else -%}
        <span class="text-[11px] font-medium text-neutral-400 uppercase">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
  </div>
</article>
