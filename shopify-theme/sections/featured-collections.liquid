{% comment %}
  KINETIC Featured Collections Grid Section
{% endcomment %}

<section class="py-16 lg:py-24 bg-white border-b border-neutral-200" data-section-id="{{ section.id }}">
  <div class="page-container">
    <div class="mb-10">
      <p class="eyebrow-text mb-1">DISCOVER</p>
      <h2 class="text-2xl lg:text-3xl font-bold uppercase tracking-tight text-neutral-900">
        {{ section.settings.heading | default: 'POPULAR HARDWARE LINES' }}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <div class="border border-neutral-200 bg-neutral-50 p-6 flex flex-col justify-between group hover:border-neutral-900 transition-colors" {{ block.shopify_attributes }}>
          <div>
            <span class="text-[11px] font-mono uppercase text-neutral-500">Collection</span>
            <h3 class="text-xl font-bold uppercase tracking-tight text-neutral-900 mt-2 mb-3">
              {{ block.settings.title | default: collection.title | default: 'Gaming Series' }}
            </h3>
            <p class="text-xs text-neutral-600 line-clamp-3 mb-6">
              {{ block.settings.description | default: collection.description | default: 'Tournament-ready gaming hardware optimized for response rate and structural endurance.' }}
            </p>
          </div>

          <a href="{{ collection.url | default: '/collections/all' }}" class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
            <span>Explore Collection</span>
            {% render 'icon', name: 'chevron-right', class: 'w-3.5 h-3.5' %}
          </a>
        </div>
      {%- else -%}
        <div class="border border-neutral-200 bg-neutral-50 p-6">
          <span class="text-[11px] font-mono uppercase text-neutral-500">Collection</span>
          <h3 class="text-xl font-bold uppercase tracking-tight text-neutral-900 mt-2 mb-3">Pro Audio Series</h3>
          <p class="text-xs text-neutral-600 mb-6">Planar magnetic drivers with zero soundstage distortion.</p>
          <a href="/collections/all" class="text-xs font-bold uppercase text-neutral-900">Explore Collection &rarr;</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "POPULAR HARDWARE LINES"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
