{% comment %}
  KINETIC Minimalist Newsletter Section
  Uses Shopify's native customer form with tags 'newsletter'
{% endcomment %}

<section class="bg-[#111111] text-white py-16 lg:py-24 border-b border-neutral-800" data-section-id="{{ section.id }}">
  <div class="page-container max-w-3xl text-center">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-neutral-400 mb-3">
      COMMUNITY & UPDATES
    </p>

    <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-white mb-4">
      {{ section.settings.heading | default: 'STAY IN THE GAME' }}
    </h2>

    <p class="text-sm sm:text-base text-neutral-400 max-w-xl mx-auto mb-8 font-normal leading-relaxed">
      {{ section.settings.description | default: 'Get updates about new gaming gear, launches and exclusive offers.' }}
    </p>

    <!-- Shopify Native Customer Newsletter Form -->
    {%- form 'customer', class: 'max-w-md mx-auto', id: 'ContactNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <div class="p-4 bg-neutral-900 border border-neutral-700 text-white text-sm mb-4">
          {{ 'general.newsletter_success' | t }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="p-4 bg-red-900/40 border border-red-500 text-red-200 text-xs mb-4">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </div>
      {%- endif -%}

      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail"
          value="{{ form.email }}"
          placeholder="{{ 'general.newsletter_placeholder' | t }}"
          class="flex-1 bg-neutral-900 border border-neutral-700 text-white placeholder-neutral-500 px-4 py-3.5 text-xs focus:outline-none focus:border-white transition-colors"
          required
          aria-required="true"
          autocomplete="email"
        >
        <button
          type="submit"
          class="btn-primary btn-dark"
          name="commit"
        >
          {{ 'general.newsletter_button' | t }}
        </button>
      </div>

      <p class="text-[11px] text-neutral-500 mt-3">
        Zero spam. Unsubscribe anytime with one click.
      </p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY IN THE GAME"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get updates about new gaming gear, launches and exclusive offers."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
