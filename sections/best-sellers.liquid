{% comment %}
  KINETIC Best Sellers Carousel Section
  Smooth horizontal product carousel with navigation controls and mobile touch swipe
{% endcomment %}

<section class="py-16 lg:py-24 bg-white border-b border-neutral-200" data-section-id="{{ section.id }}">
  <div class="page-container">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow-text mb-1">MOST POPULAR</p>
        <h2 class="text-2xl lg:text-3xl font-bold uppercase tracking-tight text-neutral-900">
          {{ section.settings.heading | default: 'BEST SELLERS' }}
        </h2>
      </div>

      <!-- Carousel Navigation Arrows -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 border border-neutral-200 flex items-center justify-center text-neutral-700 hover:border-neutral-900 hover:text-neutral-900 transition-colors"
          onclick="const c = this.closest('section').querySelector('.scroll-container'); c.scrollBy({ left: -320, behavior: 'smooth' });"
          aria-label="Previous items"
        >
          {% render 'icon', name: 'chevron-left', class: 'w-4 h-4' %}
        </button>
        <button
          type="button"
          class="w-10 h-10 border border-neutral-200 flex items-center justify-center text-neutral-700 hover:border-neutral-900 hover:text-neutral-900 transition-colors"
          onclick="const c = this.closest('section').querySelector('.scroll-container'); c.scrollBy({ left: 320, behavior: 'smooth' });"
          aria-label="Next items"
        >
          {% render 'icon', name: 'chevron-right', class: 'w-4 h-4' %}
        </button>
      </div>
    </div>

    <!-- Product Scroll Container -->
    <div class="scroll-container pb-4 -mx-4 px-4 sm:mx-0 sm:px-0">
      {%- assign collection = section.settings.collection -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: 10 -%}
          <div class="w-[260px] sm:w-[300px] shrink-0">
            {% render 'product-card',
              product: product,
              show_vendor: true,
              show_rating: true,
              show_quick_add: true
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Editorial Preview Items -->
        {%- for i in (1..6) -%}
          <div class="w-[260px] sm:w-[300px] shrink-0 product-card">
            <div class="product-card-media relative">
              <div class="w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400 text-xs font-medium uppercase tracking-wider">
                Hardware 0{{ i }}
              </div>
            </div>
            <div class="p-4 flex flex-col justify-between flex-1">
              <div>
                <p class="text-[11px] font-semibold text-neutral-400 uppercase">KINETIC</p>
                <h3 class="text-sm font-semibold text-neutral-900 mt-1">Titan Ultra Gaming Peripheral 0{{ i }}</h3>
                <div class="mt-1.5">
                  {% render 'rating', rating: 4.9, count: 112 %}
                </div>
              </div>
              <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between">
                <span class="text-sm font-bold text-neutral-900">$149.00</span>
                <span class="text-[11px] text-neutral-500">In Stock</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers Carousel",
  "tag": "section",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Carousel"
    }
  ]
}
{% endschema %}
