{% comment %}
  KINETIC Minimalist Gaming Collection Section
  Features real Shopify storefront filtering, sorting, responsive grid, and pagination
{% endcomment %}

{%- paginate collection.products by section.settings.products_per_page -%}
<section class="py-8 lg:py-16 bg-white border-b border-neutral-200" data-section-id="{{ section.id }}">
  <div class="page-container">
    {% render 'breadcrumbs' %}

    <!-- Collection Header -->
    <div class="py-6 border-b border-neutral-200 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow-text mb-1">COLLECTION</p>
        <h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-neutral-900">
          {{ collection.title }}
        </h1>
        {%- if collection.description != blank -%}
          <p class="mt-2 text-sm text-neutral-600 leading-relaxed">
            {{ collection.description }}
          </p>
        {%- endif -%}
      </div>

      <div class="flex items-center gap-4 text-xs font-semibold text-neutral-500">
        <span>{{ 'sections.collection_template.product_count' | t: count: collection.products_count }}</span>
      </div>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-3 px-4 bg-neutral-50 border border-neutral-200 mb-8 text-xs">
      <!-- Facet Filters Summary -->
      <div class="flex items-center gap-3">
        <span class="font-bold uppercase tracking-wider text-neutral-900">Filters:</span>
        <a href="{{ collection.url }}" class="text-neutral-500 hover:text-neutral-900">All Equipment</a>
        <span class="text-neutral-300">|</span>
        <a href="{{ collection.url }}?filter.v.availability=1" class="text-neutral-500 hover:text-neutral-900">In Stock Only</a>
      </div>

      <!-- Native Shopify Sorting Form -->
      <form class="flex items-center gap-2" method="get">
        <label for="SortBy" class="font-bold uppercase tracking-wider text-neutral-900">Sort By:</label>
        <select
          name="sort_by"
          id="SortBy"
          class="bg-white border border-neutral-300 px-3 py-1.5 text-xs text-neutral-800 font-medium focus:outline-none focus:border-neutral-900"
          onchange="this.form.submit()"
        >
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    <!-- Product Grid -->
    {%- if collection.products.size > 0 -%}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
        {%- for product in collection.products -%}
          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            show_quick_add: section.settings.show_quick_add
          %}
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        <div class="mt-16 pt-8 border-t border-neutral-200 flex justify-center items-center gap-2">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-neutral-200 text-xs font-semibold uppercase text-neutral-800 hover:border-neutral-900">
              Previous
            </a>
          {%- endif -%}

          <span class="text-xs font-semibold px-4 text-neutral-600">
            Page {{ paginate.current_page }} of {{ paginate.pages }}
          </span>

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-neutral-200 text-xs font-semibold uppercase text-neutral-800 hover:border-neutral-900">
              Next
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="py-24 text-center">
        <p class="text-neutral-500 text-sm mb-4">{{ 'sections.collection_template.empty' | t }}</p>
        <a href="/collections/all" class="btn-primary">View All Gaming Gear</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    }
  ]
}
{% endschema %}
